{
  "name": "@dongminyu/react-native-naver-login",
  "version": "0.1.3",
  "description": "React Native TurboModule for Naver OAuth (네이버 아이디로 로그인) on iOS and Android, targeting the New Architecture.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-naver-login-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "web": "vite",
    "build:web": "vite build",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "watchman-reset": "watchman watch-del $PWD && watchman watch-project $PWD"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "naver",
    "naver-login",
    "네이버",
    "네아로",
    "oauth",
    "authentication",
    "login",
    "turbo-module",
    "new-architecture",
    "fabric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/react-native-naver-login.git"
  },
  "author": "Dongmin, Yu <ydm2790@gmail.com> (https://github.com/AndrewDongminYoo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AndrewDongminYoo/react-native-naver-login/issues"
  },
  "homepage": "https://github.com/AndrewDongminYoo/react-native-naver-login#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-builder-bob": "^0.41.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "codegenConfig": {
    "name": "NaverLoginSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.naverlogin"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "vite"
    ],
    "version": "0.62.0"
  }
}
